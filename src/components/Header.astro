---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { NAV, SITE } from '../lib/site.ts';

interface Props {
  overlay: boolean;
}
const { overlay } = Astro.props;
---

<header class="site-header" data-header data-overlay={overlay ? 'true' : 'false'} data-solid={overlay ? 'false' : 'true'}>
  <div class="wrap site-header__inner">
    <a class="site-header__brand" href="/" aria-label="Morano USA — Home">
      <Logo class="site-header__logo" />
    </a>
    <nav class="site-nav" aria-label="Main">
      <ul role="list">
        {NAV.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    <div class="site-header__actions">
      <a class="btn btn--accent btn--sm site-header__cta" href="/#quote">Request a Quote</a>
      <button class="icon-btn menu-btn" type="button" data-menu-open aria-haspopup="dialog" aria-controls="mobile-menu">
        <Icon name="menu" />
        <span class="visually-hidden">Menu</span>
      </button>
    </div>
  </div>
</header>

<dialog id="mobile-menu" class="menu" aria-label="Menu">
  <div class="menu__top">
    <a class="menu__brand" href="/" data-menu-close><Logo class="menu__logo" on="dark" eager={false} /></a>
    <button class="icon-btn" type="button" data-menu-close><Icon name="close" /><span class="visually-hidden">Close</span></button>
  </div>
  <nav class="menu__nav" aria-label="Main">
    <ol role="list">
      <li><a href="/" data-menu-close><span class="menu__idx num">01</span>Home</a></li>
      {
        NAV.map((l, i) => (
          <li>
            <a href={l.href} data-menu-close>
              <span class="menu__idx num">{String(i + 2).padStart(2, '0')}</span>
              {l.label}
            </a>
          </li>
        ))
      }
    </ol>
  </nav>
  <div class="menu__foot">
    <a class="btn btn--accent btn--block" href="/#quote" data-menu-close>Request a Quote</a>
    <div class="menu__meta">
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      <a href={`https://wa.me/${SITE.whatsapp}`} rel="noopener" target="_blank">WhatsApp</a>
    </div>
  </div>
</dialog>
