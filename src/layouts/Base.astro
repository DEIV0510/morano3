---
import '../styles/base.css';
import '../styles/site.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Loader from '../components/Loader.astro';
import WhatsApp from '../components/WhatsApp.astro';
import { SITE } from '../lib/site.ts';

interface Props {
  title: string;
  description: string;
  /** Ruta de la página (canónica), p. ej. "/commercial-sales-terms-and-conditions/". */
  path: string;
  overlayHeader?: boolean;
  showLoader?: boolean;
  noindex?: boolean;
  ogImage?: string;
  jsonLd?: Record<string, unknown>[];
}
const { title, description, path, overlayHeader = false, showLoader = false, noindex = false, ogImage = '/img/og-morano-usa.jpg', jsonLd = [] } = Astro.props;

const canonical = SITE.url + path;
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE.url}/#organization`,
  name: SITE.razonSocial,
  alternateName: SITE.nombre,
  url: `${SITE.url}/`,
  logo: `${SITE.url}/brand/usa.png`,
  image: `${SITE.url}/img/og-morano-usa.jpg`,
  slogan: SITE.lema,
  description: SITE.descripcion,
  email: SITE.email,
  address: { '@type': 'PostalAddress', streetAddress: SITE.direccion[0], addressLocality: 'St. Petersburg', addressRegion: 'FL', postalCode: '33702', addressCountry: 'US' },
  parentOrganization: { '@type': 'Organization', name: 'Morano Gruppo', url: SITE.gruppo[0].url },
};
const ld = [organization, ...jsonLd];
const ldJson = JSON.stringify(ld.length === 1 ? ld[0] : ld).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    {showLoader && <script is:inline src="/intro.js"></script>}
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Morano USA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={SITE.url + ogImage} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#00152b" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href="/fonts/jost-500.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jost-400.woff2" as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={ldJson} />
    {
      SITE.gaId && (
        <script is:inline define:vars={{ gaId: SITE.gaId, gaHost: SITE.gaHost }}>
          // Google Analytics: solo en el dominio real, para no contar vistas previas ni pruebas.
          if (location.hostname === gaHost) {
            window.dataLayer = window.dataLayer || [];
            window.gtag = function () { window.dataLayer.push(arguments); };
            window.gtag('js', new Date());
            window.gtag('config', gaId);
            var ga = document.createElement('script');
            ga.async = true;
            ga.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
            document.head.appendChild(ga);
          }
        </script>
      )
    }
    <slot name="head" />
  </head>
  <body data-overlay-header={overlayHeader ? 'true' : undefined}>
    <a class="skip-link" href="#main">Skip to content</a>
    {showLoader && <Loader />}
    <Header overlay={overlayHeader} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <WhatsApp />
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
